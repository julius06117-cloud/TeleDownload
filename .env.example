# Copy to .env and fill in. Never commit .env or *.session.
# Create API_ID / API_HASH at https://my.telegram.org (API development tools).

TGDL_API_ID=
TGDL_API_HASH=
TGDL_PHONE=

# Telethon session sqlite file. First successful `tgdl login` creates it.
TGDL_SESSION=.tgdl/tgdl.session

TGDL_OUTPUT=downloads
TGDL_WORKERS=4
TGDL_DATA_DIR=.tgdl
TGDL_FLOOD_CAP=15m

# Loopback API (tgdl serve). Leave the token empty to auto-generate .tgdl/api-token.
TGDL_API_HOST=127.0.0.1
TGDL_API_PORT=18765
TGDL_API_TOKEN=
